# =============================================================
# DB Copilot — React Frontend
# Vite dev server with hot reload in Docker Compose
# =============================================================

FROM node:20-alpine

LABEL description="React frontend for DB Copilot"

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
