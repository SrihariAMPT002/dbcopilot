# ============================================================
# DB COPILOT — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="DB Copilot"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
INTELLIGENCE_PACKAGES_ENABLED=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
WORKERS=1
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://streamlit:8501

# --- Internal PostgreSQL (Metadata Store) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dbcopilot_meta
POSTGRES_USER=dbcopilot
POSTGRES_PASSWORD=dbcopilot_secret
DATABASE_URL=postgresql+asyncpg://dbcopilot:dbcopilot_secret@postgres:5432/dbcopilot_meta
DATABASE_URL_SYNC=postgresql://dbcopilot:dbcopilot_secret@postgres:5432/dbcopilot_meta

# --- Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")  ---
ENCRYPTION_KEY=your_fernet_key_here_generate_with_command_above

# --- Web UI ---
STREAMLIT_PORT=8501
API_BASE_URL=http://fastapi:8000/api/v1

# --- Frontend (React) ---
# Use this for the TanStack/Vite frontend.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Connection Defaults ---
CONNECTION_TIMEOUT=30
MAX_POOL_SIZE=5
MIN_POOL_SIZE=1
CONNECTION_MAX_RETRIES=3
SYNC_REQUEST_TIMEOUT_SECONDS=180
EMBEDDINGS_REQUEST_TIMEOUT_SECONDS=180
PROMPT_STUDIO_REQUEST_TIMEOUT_SECONDS=180


# --- Qdrant (Vector DB) ---
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333



# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-nano

# --- PII Governance ---
PII_PROMPT_PROTECTION_ENABLED=true
PII_EMBEDDING_PROTECTION_ENABLED=true

# --- Azure OpenAI Embeddings ---
AZURE_OPENAI_EMBEDDING_URL=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=


# --- LangSmith ---
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=dbcopilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
