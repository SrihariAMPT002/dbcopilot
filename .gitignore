# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Environments ──────────────────────────────────────────────
.env
.env.local
.env.production
.venv/
venv/
env/
ENV/

